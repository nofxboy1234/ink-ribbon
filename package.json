{
  "name": "ink-ribbon",
  "private": true,
  "scripts": {
    "dev": "cd web && npm run dev",
    "build": "cd web && npm run build",
    "deploy:cloudflare": "cd web && npm run deploy:cloudflare",
    "preview": "cd web && npm run preview",
    "test": "cd web && npm run test",
    "lint": "cd web && npm run lint",
    "fmt": "cd web && npm run fmt",
    "typecheck": "cd web && npm run typecheck",
    "build:native": "cd native && cargo build",
    "run:native": "cd native && cargo run --example cube",
    "build:wasm": "cd native && ./build-wasm.sh",
    "copy:wasm": "cp native/target/wasm32-unknown-emscripten/debug/examples/cube.js native/target/wasm32-unknown-emscripten/debug/examples/cube.wasm web/public/",
    "compile:shaders": "cd native && ./compile-shaders.sh",
    "build:all": "npm run build:wasm && npm run copy:wasm"
  }
}
