{
  "name": "ink-ribbon",
  "private": true,
  "scripts": {
    "build": "cd web && npm run build",
    "deploy:cloudflare": "cd web && npm run deploy:cloudflare",
    "preview": "cd web && npm run preview",
    "test": "cd web && npm run test",
    "lint": "cd web && npm run lint",
    "fmt": "cd web && npm run fmt",
    "typecheck": "cd web && npm run typecheck",
    "assets:clean": "/usr/bin/python3 artifacts/care-center/remove-grid.py",
    "assets:runtime": "/usr/bin/python3 native/prepare-assets.py",
    "build:assets": "npm run assets:runtime",
    "build:native": "cd native && cargo build --release --example map",
    "run:native": "cd native && cargo run --release --example map",
    "build:wasm": "cd native && ./build-wasm.sh",
    "copy:wasm": "cp target/wasm32-unknown-emscripten/release/examples/map.js target/wasm32-unknown-emscripten/release/examples/map.wasm web/public/",
    "compile:shaders": "cd native && ./compile-shaders.sh",
    "build:all": "npm run build:assets && npm run build:wasm && npm run copy:wasm && npm run build",
    "check:map": "cd native && cargo fmt --check && cargo check --example map && cd ../web && npm run typecheck && npm run build",
    "dev": "npm run build:assets && npm run build:wasm && npm run copy:wasm && cd web && npm run dev"
  }
}
