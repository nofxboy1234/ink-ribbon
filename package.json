{
  "name": "ink-ribbon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "postinstall": "void prepare",
    "typecheck": "tsc --noEmit",
    "data": "uv run --with zstandard python tools/extract_rpd.py && npm run scene:import && npm run scene:export",
    "scene:import": "blender -b -P tools/rpd_scene.py -- --import",
    "scene:export": "blender -b build/rpd.blend -P tools/rpd_scene.py -- --export",
    "quest:grid": "blender -b -P tools/rpd_grid.py",
    "quest:data": "python3 tools/rpd_quest.py",
    "quest": "npm run quest:grid && npm run quest:data && npm run nav:build",
    "wasm": "bash native/build.sh",
    "deploy": "void deploy --platform cloudflare",
    "nav:build": "blender -b -P tools/rpd_nav.py"
  },
  "dependencies": {
    "hono": "4.13.14",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@void/react": "1.3.0",
    "oxc-transform-react": "0.156.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "void": "1.3.0"
  }
}
