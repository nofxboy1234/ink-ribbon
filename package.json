{
  "name": "ink-ribbon",
  "private": true,
  "scripts": {
    "dev": "cd web && npm run dev",
    "build": "cd web && npm run build",
    "test": "cd web && npm run test",
    "lint": "cd web && npm run lint",
    "fmt": "oxfmt --write .",
    "typecheck": "cd web && npm run typecheck",
    "build:wasm": "cd native && zig build -Dtarget=wasm32-emscripten",
    "build:native": "cd native && zig build",
    "run:native": "cd native && zig build run",
    "copy:wasm": "cp native/zig-out/web/cube.js native/zig-out/web/cube.wasm web/public/",
    "build:all": "npm run build:wasm && npm run copy:wasm"
  }
}
